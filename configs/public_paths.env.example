# Copy outside the repository, customize, then source the copy in a POSIX shell.
# These variables are passed to the Python CLI; Python does not parse this file.
export ASOCA_MANIFEST=/path/to/prepared-ASOCA/cache/manifest.json
export ASOCA_RAW_ROOT=/path/to/ASOCA/CompressedVersion
export GTA_OUTPUT_ROOT=/path/to/experiment-results
export GTA_AIRWAY_BACKBONE_INIT=/path/to/externally-obtained/airway_backbone.pkl
export GTA_AIRWAY_CLASSIFIER_INIT=/path/to/externally-obtained/airway_classifier.pkl
