  --gaussian-ramp-end GAUSSIAN_RAMP_END
  --save-every SAVE_EVERY
  --gradient-probe-every GRADIENT_PROBE_EVERY
  --guidance-weight GUIDANCE_WEIGHT
  --seg-loss {dice_ce,historical}
  --sampling {standard,geometry}
  --sampling-fov {full,image-body}
